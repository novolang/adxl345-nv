// adxl345 — Analog Devices' ADXL345 three-axis accelerometer, on its I2C
// or its SPI bus, as devices-nv's `Accelerometer` and `Identifiable`.
//
// The facts below are from Analog Devices' "ADXL345 Data Sheet", document
// D07925-0-6/15(E), Rev. E, June 2015 (the copy that could be fetched;
// its tables are named by number).  Where the sheet and the drivers read
// for this one disagree, the site says which was taken.
//
// The register map (Table 19), as this driver uses it:
//
//   0x00  DEVID          0xE5
//   0x1D  THRESH_TAP     62.5 mg per count
//   0x21  DUR            625 us per count; 0 disables tap detection
//   0x22  LATENT         1.25 ms per count; 0 disables the double tap
//   0x23  WINDOW         1.25 ms per count; 0 disables the double tap
//   0x24  THRESH_ACT     62.5 mg per count
//   0x25  THRESH_INACT   62.5 mg per count
//   0x26  TIME_INACT     1 s per count
//   0x27  ACT_INACT_CTL  ACT ac/dc (7), ACT_X/Y/Z (6:4), INACT ac/dc (3),
//                        INACT_X/Y/Z (2:0)
//   0x28  THRESH_FF      62.5 mg per count
//   0x29  TIME_FF        5 ms per count
//   0x2A  TAP_AXES       Suppress (3), TAP_X (2), TAP_Y (1), TAP_Z (0)
//   0x2B  ACT_TAP_STATUS the axes that caused activity and tap
//   0x2C  BW_RATE        LOW_POWER (4), Rate (3:0)
//   0x2D  POWER_CTL      Link (5), AUTO_SLEEP (4), Measure (3), Sleep (2),
//                        Wakeup (1:0)
//   0x2E  INT_ENABLE     DATA_READY (7), SINGLE_TAP (6), DOUBLE_TAP (5),
//                        Activity (4), Inactivity (3), FREE_FALL (2),
//                        Watermark (1), Overrun (0)
//   0x2F  INT_MAP        the same bits; set routes to INT2, clear to INT1
//   0x30  INT_SOURCE     the same bits; reset value 0x02
//   0x31  DATA_FORMAT    SELF_TEST (7), SPI (6), INT_INVERT (5),
//                        FULL_RES (3), Justify (2), Range (1:0)
//   0x32  DATAX0 to 0x37 DATAZ1: each axis a 16-bit two's complement
//         count, low byte first
//   0x38  FIFO_CTL       FIFO_MODE (7:6), Trigger (5), Samples (4:0)
//   0x39  FIFO_STATUS    FIFO_TRIG (7), Entries (5:0)
//
// The resolution and the step.  In the fixed 10-bit mode the range sets
// the step: 256, 128, 64 and 32 counts per g at ±2, ±4, ±8 and ±16 g
// (Table 1), 3.9, 7.8, 15.6 and 31.2 mg.  In full resolution (FULL_RES)
// the step stays 256 counts per g and the count grows to 10, 11, 12 and
// 13 bits.  Both come to the same figure, the range's full scale over
// 2^(bits - 1), which is what `dev_accel.accel_milli_g` computes.  The
// Justify bit places the count at the top of the 16 bits instead of the
// bottom, with the unused bits zero; the driver reads the bit and shifts.
//
// The output data rate (Table 7).  Rate code 1010 is 100 Hz, and each
// code below halves the rate, down to 0000 at 0.098 Hz, the figure Table
// 7 prints as 0.10.  Code 1111 is 3200 Hz.  LOW_POWER lowers the noise
// floor's current draw at 12.5 to 400 Hz only (Table 8).
//
// The two buses.  On I2C the part answers at 0x1D (ALT ADDRESS high) or
// 0x53 (ALT ADDRESS low), and the register address advances after every
// byte of a read or a write (p. 15).  On SPI a transaction is a command
// byte, then data, inside one chip-select window: bit 7 is R/W (1 reads),
// bit 6 is MB (1 advances the register address after each byte), bits 5
// to 0 the register.  The part takes SPI mode 3 up to 5 MHz.  The CS pin
// must be high, or driven, for I2C to work: it has no default (p. 15).
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/adi/adxl345`.  Each fix kept is named at its site.
//
// The driver holds no state: the format is read from the part in the same
// transaction as the sample.
//
// A bus enters through `Adxl345Port`, which a type that holds a bus
// implements: `Adxl345` for an I2C bus and `Adxl345Spi` for an SPI bus.
// The framing of each bus is the generic functions `i2c_read_into`,
// `i2c_write`, `spi_read_into` and `spi_write`, so a test runs them over
// a double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, Accelerometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let DEVID          = 0x00
let THRESH_TAP     = 0x1D
let DUR            = 0x21
let LATENT         = 0x22
let WINDOW         = 0x23
let THRESH_ACT     = 0x24
let THRESH_INACT   = 0x25
let TIME_INACT     = 0x26
let ACT_INACT_CTL  = 0x27
let THRESH_FF      = 0x28
let TIME_FF        = 0x29
let TAP_AXES       = 0x2A
let ACT_TAP_STATUS = 0x2B
let BW_RATE        = 0x2C
let POWER_CTL      = 0x2D
let INT_ENABLE     = 0x2E
let INT_MAP        = 0x2F
let INT_SOURCE     = 0x30
let DATA_FORMAT    = 0x31
let DATAX0         = 0x32
let FIFO_CTL       = 0x38
let FIFO_STATUS    = 0x39

// DEVID's value.
let ID_ADXL345 = 0xE5

// The SPI command byte's R/W and MB bits.
let SPI_READ  = 0x80
let SPI_MULTI = 0x40

// INT_ENABLE, INT_MAP and INT_SOURCE share their bits.  A program ORs
// them to build the `enable` and `map` bytes of `int_config`.

// New data is ready.
pub const INT_DATA_READY = 0x80

// A single tap was detected.
pub const INT_SINGLE_TAP = 0x40

// A double tap was detected.
pub const INT_DOUBLE_TAP = 0x20

// The acceleration went above the activity threshold.
pub const INT_ACTIVITY = 0x10

// The acceleration stayed under the inactivity threshold for its time.
pub const INT_INACTIVITY = 0x08

// The acceleration stayed under the free-fall threshold for its time.
pub const INT_FREE_FALL = 0x04

// The FIFO holds the number of samples FIFO_CTL names.
pub const INT_WATERMARK = 0x02

// New data replaced unread data.
pub const INT_OVERRUN = 0x01

// TAP_AXES' bits for `tap_config`.  Suppress keeps a double tap from being
// reported when the acceleration goes above the threshold between the taps.

// Suppress.
pub const TAP_SUPPRESS = 0x08

// The X axis takes part.
pub const TAP_X = 0x04

// The Y axis takes part.
pub const TAP_Y = 0x02

// The Z axis takes part.
pub const TAP_Z = 0x01

// The nibble of ACT_INACT_CTL for one of activity and inactivity, for
// `activity_config` and `inactivity_config`.

// Ac coupling in place of dc: the threshold applies to the change from a
// reference taken when detection starts.
pub const AXES_AC = 0x08

// The X axis takes part.
pub const AXES_X = 0x04

// The Y axis takes part.
pub const AXES_Y = 0x02

// The Z axis takes part.
pub const AXES_Z = 0x01

// DATA_FORMAT: the self-test force, the active-low interrupt pins, full
// resolution, the left-justified count, and the range.
let FMT_SELF_TEST = 0x80
let FMT_INVERT    = 0x20
let FMT_FULL_RES  = 0x08
let FMT_JUSTIFY   = 0x04
let FMT_RANGE     = 0x03

// BW_RATE: the low-power bit and the rate code.
let RATE_LOW_POWER = 0x10
let RATE_CODE      = 0x0F

// POWER_CTL: measurement on.
let POWER_MEASURE = 0x08

// FIFO_CTL: stream mode, the mode that keeps the newest samples.
let FIFO_STREAM = 0x80
// FIFO_STATUS: the entry count.
let FIFO_ENTRIES = 0x3F
// The most samples the driver moves out of the FIFO in one call.  The
// part holds 32 and shows 33 at most, because the output registers hold
// one more (p. 27).
let FIFO_DEPTH = 32

// The rate code `start` sets, 100 Hz.
let RATE_100 = 10

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ = 400000
let SPI_HZ = 4000000
let SPI_MODE = 3

// The most polls of the data-ready flag a self-test makes for one
// sample: a sample takes 10 ms at 100 Hz, and a poll over I2C takes about
// 100 us.
let SELF_TEST_POLLS = 4000
// Samples the self-test lets settle after a change, and averages (p. 31).
let SELF_TEST_SETTLE = 4
let SELF_TEST_AVERAGE = 10

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `irq_level` answers the level of the interrupt pin.
pub trait Adxl345Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]

// ── The two buses ────────────────────────────────────────────────────

// The command byte that goes out for a read of `n` registers from `reg`
// on SPI: R/W set, and MB set for more than one.  Without MB every byte
// repeats the first register.
fn spi_cmd_of(reg: Int, n: Int) -> Int
    var cmd = SPI_READ | (reg & 0x3F)
    if n > 1
        cmd = cmd | SPI_MULTI
    cmd

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the register and a repeated start: whether the part answered.
// The address advances by itself.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction:
// whether it ran, which is whether the wiring has a chip select.  An
// absent part reads 0xFF, which the callers check for.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                            n: Int, var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push(spi_cmd_of(reg, n) as u8)
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n, var dst)

// Writes `v` to the register `reg` in one SPI transaction, R/W and MB
// clear: whether it ran.  The part answers nothing to a write.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x3F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the interrupt pin an input, the bus at 400
// kHz.  Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// Makes an SPI bus ready: chip select driven high first, so the pin
// never drives low and the part stays on the bus it was reset on, then
// an output; the interrupt pin an input; the bus at 4 MHz in mode 3.
// Answers whether the wiring has a chip select.
pub fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    let Some(cs) = w.cs else return false
    gpio.set(cs, 1)
    gpio.mode(cs, 1)
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(SPI_HZ, SPI_MODE)
    true

// The level of the part's interrupt line on the board, 1 or 0, or -1 for
// a wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Adxl345Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  A register that changes by itself is written with
// `write_reg`.
pub fn reg_write<P: Adxl345Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `bits`, leaving the
// others: whether the part took it.
//
// Fix kept: Zephyr's driver updates POWER_CTL and DATA_FORMAT with a
// mask for the same reason; a whole-register write would clear SPI,
// INT_INVERT or the justify bit set elsewhere.
pub fn reg_update<P: Adxl345Port>(p: P, reg: Int, mask: Int, bits: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (bits & mask))

// ── Identity ─────────────────────────────────────────────────────────

// DEVID as a `DeviceId`, or `None` when no part answers: the byte reads
// 0xFF on an SPI bus no part drives and 0x00 on one held low.
pub fn id_read<P: Adxl345Port>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, DEVID) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: None })

// ── Conversions ──────────────────────────────────────────────────────

// The range a DATA_FORMAT byte's Range bits select.
pub fn range_of_format(v: Int) -> AccelRange
    match v & FMT_RANGE
        0 => AccelRange2g
        1 => AccelRange4g
        2 => AccelRange8g
        _ => AccelRange16g

// The Range bits for a range.
pub fn bits_of_range(r: AccelRange) -> Int
    match r
        AccelRange2g  => 0
        AccelRange4g  => 1
        AccelRange8g  => 2
        AccelRange16g => 3

// How many bits of an axis are valid for a DATA_FORMAT byte: 10 in the
// fixed mode, and 10, 11, 12 and 13 in full resolution at ±2, ±4, ±8 and
// ±16 g (Table 1).
pub fn bits_of_format(v: Int) -> Int
    if (v & FMT_FULL_RES) == 0
        return 10
    10 + (v & FMT_RANGE)

// The milli-g of an axis whose low byte is at `i` of `b`, for the
// DATA_FORMAT byte `df`: the 16-bit count with its sign kept, shifted
// down when the count is left-justified, times the step.
fn axis(b: DevBytes, i: Int, df: Int) -> Int
    let nb = bits_of_format(df)
    var count = dev_bus.dev_sign_extend((b[i + 1] as Int << 8) | b[i] as Int, 16)
    if (df & FMT_JUSTIFY) != 0
        count = count >> (16 - nb)
    dev_accel.accel_milli_g(count, nb, range_of_format(df))

// The rate in thousandths of a hertz a BW_RATE rate code selects: 3200 Hz
// for 1111 and half as much for each code below, rounded to the nearest
// thousandth.  Table 7 prints the lowest as 0.10 Hz.
pub fn rate_mhz_of_code(code: Int) -> Int
    let sh = 15 - (code & RATE_CODE)
    if sh == 0
        return 3200000
    (3200000 + (1 << (sh - 1))) >> sh

// A rate in thousandths of a hertz as whole hertz: to the nearest, and at
// least 1 for a part that is sampling.
pub fn hz_of_mhz(mhz: Int) -> Int
    let hz = (mhz + 500) / 1000
    if hz < 1
        return 1
    hz

// The rate code of the slowest rate at or above `mhz`, or of the fastest
// the part has.
pub fn code_for_mhz(mhz: Int) -> Int
    for code in 0..15
        if rate_mhz_of_code(code) >= mhz
            return code
    15

// Whether a rate code is one that low-power mode has: 12.5 Hz to 400 Hz,
// codes 0111 to 1100 (Table 8).
pub fn low_power_code(code: Int) -> Bool
    code >= 7 and code <= 12

// ── Samples ──────────────────────────────────────────────────────────

// The most recent sample, in one burst of seven registers from
// DATA_FORMAT to DATAZ1, so the format it is converted with is the one it
// was taken in.  `None` when the part did not answer.
//
// Fix kept: Analog Devices' sheet asks for a multiple-byte read of all
// the data registers so the axes come from one sample (p. 26), and
// Zephyr's driver reads the six in one burst.  A read of the data
// registers while the FIFO is on takes one entry out of it.
pub fn sample_read<P: Adxl345Port>(p: P) -> ?AccelMilliG [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(DATA_FORMAT, 7, var b)
        return None
    let df = b[0] as Int
    Some(AccelMilliG { x: axis(b, 1, df), y: axis(b, 3, df), z: axis(b, 5, df) })

// Whether a new sample has completed since the last read: INT_SOURCE's
// DATA_READY, which a read of the data registers clears.  A read of
// INT_SOURCE also clears the latched tap, activity, inactivity and
// free-fall flags, so a program that uses those reads the flags itself
// with `int_source` and takes DATA_READY from them.
pub fn sample_ready<P: Adxl345Port>(p: P) -> Bool [hw]
    ((reg_read(p, INT_SOURCE) ?? 0) & INT_DATA_READY) != 0

// The range the part is set to, ±2 g when it does not answer.
pub fn range_read<P: Adxl345Port>(p: P) -> AccelRange [hw]
    range_of_format(reg_read(p, DATA_FORMAT) ?? 0)

// Sets the range and leaves the other bits of DATA_FORMAT: whether the
// part took it.  Samples already in the FIFO keep the format they were
// taken in, and are converted with the new one.
pub fn range_write<P: Adxl345Port>(p: P, r: AccelRange) -> Bool [hw]
    reg_update(p, DATA_FORMAT, FMT_RANGE, bits_of_range(r))

// Sets full resolution or the fixed 10-bit mode: whether the part took it.
pub fn full_res_write<P: Adxl345Port>(p: P, on: Bool) -> Bool [hw]
    var v = 0
    if on
        v = FMT_FULL_RES
    reg_update(p, DATA_FORMAT, FMT_FULL_RES, v)

// Sets the left-justified count or the right-justified one: whether the
// part took it.
pub fn justify_write<P: Adxl345Port>(p: P, left: Bool) -> Bool [hw]
    var v = 0
    if left
        v = FMT_JUSTIFY
    reg_update(p, DATA_FORMAT, FMT_JUSTIFY, v)

// The rate the part samples at in thousandths of a hertz, 0 when it does
// not answer.
pub fn rate_read<P: Adxl345Port>(p: P) -> Int [hw]
    let Some(v) = reg_read(p, BW_RATE) else return 0
    rate_mhz_of_code(v)

// Sets the slowest rate at or above `mhz` thousandths of a hertz, and
// answers the rate taken in the same unit, or 0 when the part did not
// take it.  LOW_POWER is kept when the new rate is one it allows and
// cleared otherwise (Table 8).  The first sample comes after the turn-on
// time of 1.1 ms plus a period (Table 1, note 7).
pub fn rate_write<P: Adxl345Port>(p: P, mhz: Int) -> Int [hw]
    let Some(old) = reg_read(p, BW_RATE) else return 0
    let code = code_for_mhz(mhz)
    var lp = old & RATE_LOW_POWER
    if not low_power_code(code)
        lp = 0
    if not reg_write(p, BW_RATE, lp | code)
        return 0
    rate_mhz_of_code(code)

// The rate in whole hertz, to the nearest and at least 1; 0 when the part
// did not answer.
pub fn rate_hz_read<P: Adxl345Port>(p: P) -> Int [hw]
    let mhz = rate_read(p)
    if mhz == 0
        return 0
    hz_of_mhz(mhz)

// Sets the slowest rate at or above `hz` and answers the rate taken in
// whole hertz, 0 when the part did not take it.
pub fn rate_hz_write<P: Adxl345Port>(p: P, hz: Int) -> Int [hw]
    let mhz = rate_write(p, hz * 1000)
    if mhz == 0
        return 0
    hz_of_mhz(mhz)

// Whether low-power mode is on.  False when the part did not answer.
pub fn low_power_read<P: Adxl345Port>(p: P) -> Bool [hw]
    ((reg_read(p, BW_RATE) ?? 0) & RATE_LOW_POWER) != 0

// Turns low-power mode on or off: whether the part took it.  Low-power
// mode is refused, with no write, at a rate outside 12.5 Hz to 400 Hz,
// where it saves no current (Table 8).
pub fn low_power_write<P: Adxl345Port>(p: P, on: Bool) -> Bool [hw]
    let Some(old) = reg_read(p, BW_RATE) else return false
    if on and not low_power_code(old & RATE_CODE)
        return false
    var lp = 0
    if on
        lp = RATE_LOW_POWER
    reg_write(p, BW_RATE, lp | (old & RATE_CODE))

// ── The FIFO ─────────────────────────────────────────────────────────
//
// The FIFO holds 32 samples of three axes (p. 21).  It is off after
// `start`; `fifo_start` turns it on in stream mode, which overwrites the
// oldest sample when it is full, and `fifo_stop` turns it off.  A sample
// is read from it through DATAX0 to DATAZ1 like a live one.  A read of
// one sample is a burst of the six registers, because each level is
// cleared by any read of the FIFO, a single-byte read included, and the
// rest of the sample would be lost (p. 27).  The sheet asks for 5 us
// between the end of one such read and the start of the next, or of a
// FIFO_STATUS read; two transactions are further apart than that on both
// buses, since chip select rises between them.

// Turns the FIFO on in stream mode with the watermark at `threshold`
// samples, 1 to 31, and puts the watermark on INT1 in place of the
// data-ready: whether the part took every setting.
//
// Fix kept: the sheet says a samples value of 0 sets the watermark flag
// at once, whatever the mode (p. 27), so the threshold is held to 1 at the
// lowest.
pub fn fifo_start<P: Adxl345Port>(p: P, threshold: Int) -> Bool [hw]
    var th = threshold
    if th < 1
        th = 1
    if th > 31
        th = 31
    if not reg_write(p, FIFO_CTL, FIFO_STREAM | th)
        return false
    reg_update(p, INT_ENABLE, INT_WATERMARK | INT_DATA_READY, INT_WATERMARK)

// Turns the FIFO off and puts the data-ready back on INT1: whether the
// part took every setting.  Bypass mode empties the FIFO.
pub fn fifo_stop<P: Adxl345Port>(p: P) -> Bool [hw]
    if not reg_write(p, FIFO_CTL, 0)
        return false
    reg_update(p, INT_ENABLE, INT_WATERMARK | INT_DATA_READY, INT_DATA_READY)

// The number of samples in the FIFO, at most 32: 0 when it is empty or
// the part did not answer.  The part reports up to 33, one of them being
// in the output registers.
pub fn fifo_count<P: Adxl345Port>(p: P) -> Int [hw]
    let n = (reg_read(p, FIFO_STATUS) ?? 0) & FIFO_ENTRIES
    if n > FIFO_DEPTH
        return FIFO_DEPTH
    n

// Moves the samples of the FIFO, oldest first, into `dst`, which is
// emptied first, and answers how many it moved.  The count is read once,
// the format once, and each sample is one burst of the six data
// registers.
pub fn fifo_read<P: Adxl345Port>(p: P, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
    dst.clear()
    let n = fifo_count(p)
    if n == 0
        return 0
    let Some(df) = reg_read(p, DATA_FORMAT) else return 0
    var moved = 0
    for _i in 0..n
        var b: DevBytes = Vec.new()
        if not p.read_regs(DATAX0, 6, var b)
            return moved
        let _ = dst.push(AccelMilliG { x: axis(b, 0, df), y: axis(b, 2, df), z: axis(b, 4, df) })
        moved = moved + 1
    moved

// ── Thresholds and times ─────────────────────────────────────────────

// A threshold in milli-g as a count of 62.5 mg, to the nearest and held
// to 1 to 255: the sheet warns that 0 may misbehave once the interrupt is
// on (p. 24).
pub fn thresh_of_mg(mg: Int) -> Int
    let n = (mg * 2 + 62) / 125
    if n < 1
        return 1
    if n > 255
        return 255
    n

// A time in microseconds as a count of `unit_us`, truncated and held to 0
// to 255.  A zero DUR, LATENT or WINDOW disables the tap function it
// belongs to.
pub fn count_of_us(us: Int, unit_us: Int) -> Int
    let n = us / unit_us
    if n < 0
        return 0
    if n > 255
        return 255
    n

// A free-fall time in milliseconds as a count of 5 ms, held to 1 to 255.
pub fn time_ff_of_ms(ms: Int) -> Int
    let n = ms / 5
    if n < 1
        return 1
    if n > 255
        return 255
    n

// An inactivity time in seconds as a count of 1 s, held to 0 to 255.
pub fn time_inact_of_s(s: Int) -> Int
    if s < 0
        return 0
    if s > 255
        return 255
    s

// ── Detection and the interrupt pins ─────────────────────────────────
//
// The part detects taps, activity, inactivity and free fall by itself.
// The functions below write their thresholds and times; `int_config`
// turns the flags into pin events.  The sheet advises configuring a
// function with its interrupt disabled and enabling it afterward (p. 20),
// which is the order these are used in.

// Configures tap detection: the threshold in milli-g, the longest a tap
// lasts in microseconds (625 us per count), the wait before the double-tap
// window in microseconds (1.25 ms per count), the window in microseconds,
// and TAP_AXES' byte, `TAP_X`, `TAP_Y` and `TAP_Z` with `TAP_SUPPRESS`.  A
// zero duration disables the single tap; a zero latency or window
// disables the double tap.  Whether the part took every setting.
pub fn tap_config<P: Adxl345Port>(p: P, thresh_mg: Int, dur_us: Int, latent_us: Int,
                                  window_us: Int, axes: Int) -> Bool [hw]
    if not reg_write(p, THRESH_TAP, thresh_of_mg(thresh_mg))
        return false
    if not reg_write(p, DUR, count_of_us(dur_us, 625))
        return false
    if not reg_write(p, LATENT, count_of_us(latent_us, 1250))
        return false
    if not reg_write(p, WINDOW, count_of_us(window_us, 1250))
        return false
    reg_write(p, TAP_AXES, axes & 0x0F)

// Configures activity detection: the threshold in milli-g and the axes,
// as the nibble `AXES_AC`, `AXES_X`, `AXES_Y` and `AXES_Z` make.  The
// inactivity half of ACT_INACT_CTL is kept.  Whether the part took it.
pub fn activity_config<P: Adxl345Port>(p: P, thresh_mg: Int, axes: Int) -> Bool [hw]
    if not reg_write(p, THRESH_ACT, thresh_of_mg(thresh_mg))
        return false
    reg_update(p, ACT_INACT_CTL, 0xF0, (axes & 0x0F) << 4)

// Configures inactivity detection: the threshold in milli-g, the time in
// seconds the acceleration stays under it, and the axes as the nibble
// `AXES_AC`, `AXES_X`, `AXES_Y` and `AXES_Z` make.  The activity half of
// ACT_INACT_CTL is kept.  Whether the part took it.
pub fn inactivity_config<P: Adxl345Port>(p: P, thresh_mg: Int, time_s: Int,
                                         axes: Int) -> Bool [hw]
    if not reg_write(p, THRESH_INACT, thresh_of_mg(thresh_mg))
        return false
    if not reg_write(p, TIME_INACT, time_inact_of_s(time_s))
        return false
    reg_update(p, ACT_INACT_CTL, 0x0F, axes & 0x0F)

// Configures free-fall detection: the threshold in milli-g, 300 to 600 as
// the sheet advises, and the time in milliseconds the acceleration stays
// under it on all three axes (5 ms per count).  Whether the part took it.
pub fn free_fall_config<P: Adxl345Port>(p: P, thresh_mg: Int, time_ms: Int) -> Bool [hw]
    if not reg_write(p, THRESH_FF, thresh_of_mg(thresh_mg))
        return false
    reg_write(p, TIME_FF, time_ff_of_ms(time_ms))

// Routes interrupt flags to the pins: `enable` is the INT_ENABLE byte,
// `map` the INT_MAP byte (a set bit routes to INT2, a clear one to INT1),
// and `active_low` flips the pins' polarity.  The interrupts are turned
// off first, the map and the polarity written, INT_SOURCE read to clear
// what was latched, and then the interrupts turned on, in the order the
// sheet advises (p. 20).  Whether the part took every setting.
pub fn int_config<P: Adxl345Port>(p: P, enable: Int, map: Int, active_low: Bool) -> Bool [hw]
    var inv = 0
    if active_low
        inv = FMT_INVERT
    if not reg_write(p, INT_ENABLE, 0)
        return false
    if not reg_write(p, INT_MAP, map)
        return false
    if not reg_update(p, DATA_FORMAT, FMT_INVERT, inv)
        return false
    let _stale = reg_read(p, INT_SOURCE)
    reg_write(p, INT_ENABLE, enable)

// Reads INT_SOURCE, which clears the latched tap, activity, inactivity and
// free-fall flags, and answers it, or -1 when the part did not answer.
pub fn int_source<P: Adxl345Port>(p: P) -> Int [hw]
    reg_read(p, INT_SOURCE) ?? -1

// Reads ACT_TAP_STATUS, the axes that caused the last activity and tap,
// and answers it, or -1 when the part did not answer.
pub fn act_tap_status<P: Adxl345Port>(p: P) -> Int [hw]
    reg_read(p, ACT_TAP_STATUS) ?? -1

// ── Self-test ────────────────────────────────────────────────────────

// Waits for the next sample by polling INT_SOURCE's DATA_READY, at most
// `SELF_TEST_POLLS` times: whether one came.
fn wait_sample<P: Adxl345Port>(p: P) -> Bool [hw]
    for _i in 0..SELF_TEST_POLLS
        if sample_ready(p)
            return true
    false

// Lets `SELF_TEST_SETTLE` samples pass, then averages `SELF_TEST_AVERAGE`
// of them, in milli-g: `None` when a sample did not come.  The sums are
// of the converted values, each truncated to a milli-g.
fn settled_mean<P: Adxl345Port>(p: P) -> ?AccelMilliG [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..(SELF_TEST_SETTLE + SELF_TEST_AVERAGE)
        if not wait_sample(p)
            return None
        let Some(s) = sample_read(p) else return None
        if i >= SELF_TEST_SETTLE
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(AccelMilliG { x: sx / SELF_TEST_AVERAGE, y: sy / SELF_TEST_AVERAGE, z: sz / SELF_TEST_AVERAGE })

// The change the part's self-test makes to its outputs (p. 31): the part
// at 100 Hz in normal power, full resolution at ±16 g, is read with
// SELF_TEST clear and again with it set, ten samples averaged each time
// after four have settled, and the answer is the second mean minus the
// first, in milli-g.  Measurement is turned on if it was off.  The
// settings the part had are put back.  `None` when the part did not
// answer or a sample did not come.
//
// Table 1 gives the change as 0.20 to 2.10 g on X, -2.10 to -0.20 g on Y
// and 0.30 to 3.40 g on Z at a supply of 2.5 V; `self_test_within`
// compares a change with those limits.
pub fn self_test_delta<P: Adxl345Port>(p: P) -> ?AccelMilliG [hw]
    let Some(rate) = reg_read(p, BW_RATE) else return None
    let Some(df) = reg_read(p, DATA_FORMAT) else return None
    let Some(pwr) = reg_read(p, POWER_CTL) else return None
    let base = (df & (0xFF ^ (FMT_SELF_TEST | FMT_JUSTIFY | FMT_RANGE))) | FMT_FULL_RES | 3
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_write(p, BW_RATE, RATE_100) and reg_write(p, DATA_FORMAT, base) and reg_write(p, POWER_CTL, pwr | POWER_MEASURE)
        if let Some(off) = settled_mean(p)
            if reg_write(p, DATA_FORMAT, base | FMT_SELF_TEST)
                if let Some(on) = settled_mean(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back_fmt = reg_write(p, DATA_FORMAT, df)
    let _back_rate = reg_write(p, BW_RATE, rate)
    let _back_pwr = reg_write(p, POWER_CTL, pwr)
    if not ok
        return None
    Some(AccelMilliG { x: dx, y: dy, z: dz })

// Whether a self-test change `d` is within Table 1's limits at a supply
// of 2.5 V scaled by Table 14's factors: `xy_permille` for X and Y and
// `z_permille` for Z, in thousandths, 1000 at 2.5 V, 640 and 800 at 2.0 V,
// 1770 and 1470 at 3.3 V.
pub fn self_test_within(d: AccelMilliG, xy_permille: Int, z_permille: Int) -> Bool
    d.x >= 200 * xy_permille / 1000 and d.x <= 2100 * xy_permille / 1000 and d.y <= -200 * xy_permille / 1000 and d.y >= -2100 * xy_permille / 1000 and d.z >= 300 * z_permille / 1000 and d.z <= 3400 * z_permille / 1000

// ── Bring-up ─────────────────────────────────────────────────────────

// Brings the part up: the bus made ready; DEVID checked; the part put in
// standby and its registers put back to a known state, because it has no
// reset pin and keeps them across a restart of the program (the offsets
// are kept: they are a calibration); then full resolution at ±2 g, the
// data-ready on INT1, active high, and 100 Hz in normal power, and
// measurement on.  The sheet advises configuring in standby (p. 12).
// Answers whether the part answered as an ADXL345 and took every setting.
// The first sample comes 11 ms later (Table 1, note 7).
pub fn start<P: Adxl345Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if reg_read(p, DEVID) != Some(ID_ADXL345)
        return false
    if not reg_write(p, POWER_CTL, 0)
        return false
    if not reg_write(p, INT_ENABLE, 0)
        return false
    if not reg_write(p, FIFO_CTL, 0)
        return false
    if not reg_write(p, ACT_INACT_CTL, 0)
        return false
    if not reg_write(p, DUR, 0)
        return false
    if not reg_write(p, LATENT, 0)
        return false
    if not reg_write(p, WINDOW, 0)
        return false
    if not reg_write(p, TAP_AXES, 0)
        return false
    if not reg_write(p, INT_MAP, 0)
        return false
    if not reg_write(p, DATA_FORMAT, FMT_FULL_RES)
        return false
    if not reg_write(p, BW_RATE, RATE_100)
        return false
    let _stale = reg_read(p, INT_SOURCE)
    if not reg_write(p, INT_ENABLE, INT_DATA_READY)
        return false
    reg_write(p, POWER_CTL, POWER_MEASURE)

// ── The part on an I2C bus ───────────────────────────────────────────

// An ADXL345 on a board's I2C bus at the address `w.addr`, 0x53 or 0x1D,
// with the board's GPIO for the interrupt line.
pub @value
struct Adxl345
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Adxl345Port for Adxl345
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Adxl345
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Adxl345
        Adxl345 { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // Full resolution on or off.
    fn set_full_res(self, on: Bool) -> Bool [hw]
        full_res_write(self, on)

    // The left-justified count on or off.
    fn set_justify(self, left: Bool) -> Bool [hw]
        justify_write(self, left)

    // The rate in thousandths of a hertz, and its setter (`rate_write`).
    fn rate_mhz(self) -> Int [hw]
        rate_read(self)

    fn set_rate_mhz(self, mhz: Int) -> Int [hw]
        rate_write(self, mhz)

    // Low-power mode.
    fn low_power(self) -> Bool [hw]
        low_power_read(self)

    fn set_low_power(self, on: Bool) -> Bool [hw]
        low_power_write(self, on)

    // Turns the FIFO on with the watermark at `threshold` samples.
    fn fifo_begin(self, threshold: Int) -> Bool [hw]
        fifo_start(self, threshold)

    // Turns the FIFO off.
    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    // Tap, activity, inactivity and free-fall detection.
    fn configure_tap(self, thresh_mg: Int, dur_us: Int, latent_us: Int, window_us: Int,
                     axes: Int) -> Bool [hw]
        tap_config(self, thresh_mg, dur_us, latent_us, window_us, axes)

    fn configure_activity(self, thresh_mg: Int, axes: Int) -> Bool [hw]
        activity_config(self, thresh_mg, axes)

    fn configure_inactivity(self, thresh_mg: Int, time_s: Int, axes: Int) -> Bool [hw]
        inactivity_config(self, thresh_mg, time_s, axes)

    fn configure_free_fall(self, thresh_mg: Int, time_ms: Int) -> Bool [hw]
        free_fall_config(self, thresh_mg, time_ms)

    // The interrupt pins (`int_config`), INT_SOURCE and ACT_TAP_STATUS.
    fn configure_interrupts(self, enable: Int, map: Int, active_low: Bool) -> Bool [hw]
        int_config(self, enable, map, active_low)

    fn interrupt_flags(self) -> Int [hw]
        int_source(self)

    fn tap_status(self) -> Int [hw]
        act_tap_status(self)

    // The self-test change in milli-g (`self_test_delta`).
    fn self_test(self) -> ?AccelMilliG [hw]
        self_test_delta(self)

impl Accelerometer[hw] for Adxl345
    fn accel_read(self) -> ?AccelMilliG [hw]
        sample_read(self)

    fn accel_ready(self) -> Bool [hw]
        sample_ready(self)

    fn accel_range(self) -> AccelRange [hw]
        range_read(self)

    fn accel_set_range(self, r: AccelRange) -> Bool [hw]
        range_write(self, r)

    fn accel_rate_hz(self) -> Int [hw]
        rate_hz_read(self)

    fn accel_set_rate_hz(self, hz: Int) -> Int [hw]
        rate_hz_write(self, hz)

    fn accel_fifo_count(self) -> Int [hw]
        fifo_count(self)

    fn accel_fifo_read(self, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
        fifo_read(self, var dst)

impl Identifiable[hw] for Adxl345
    // DEVID, 0xE5; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

// ── The part on an SPI bus ───────────────────────────────────────────

// An ADXL345 on a board's SPI bus with the chip select `w.cs`, with the
// board's GPIO for the chip select and the interrupt line.
pub @value
struct Adxl345Spi
    bus: BoardSpi
    pins: BoardGpio
    w: DeviceWiring

impl Adxl345Port for Adxl345Spi
    fn setup(self) -> Bool [hw]
        spi_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        spi_read_into(self.bus, self.pins, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        spi_write(self.bus, self.pins, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Adxl345Spi
    // The part on the board's SPI bus with the chip select `w.cs`, as a
    // board's device table builds it.  Nothing is sent.
    fn attach(bus: BoardSpi, pins: BoardGpio, w: DeviceWiring) -> Adxl345Spi
        Adxl345Spi { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the wiring has no chip select.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // Full resolution on or off.
    fn set_full_res(self, on: Bool) -> Bool [hw]
        full_res_write(self, on)

    // The left-justified count on or off.
    fn set_justify(self, left: Bool) -> Bool [hw]
        justify_write(self, left)

    // The rate in thousandths of a hertz, and its setter (`rate_write`).
    fn rate_mhz(self) -> Int [hw]
        rate_read(self)

    fn set_rate_mhz(self, mhz: Int) -> Int [hw]
        rate_write(self, mhz)

    // Low-power mode.
    fn low_power(self) -> Bool [hw]
        low_power_read(self)

    fn set_low_power(self, on: Bool) -> Bool [hw]
        low_power_write(self, on)

    // Turns the FIFO on with the watermark at `threshold` samples.
    fn fifo_begin(self, threshold: Int) -> Bool [hw]
        fifo_start(self, threshold)

    // Turns the FIFO off.
    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    // Tap, activity, inactivity and free-fall detection.
    fn configure_tap(self, thresh_mg: Int, dur_us: Int, latent_us: Int, window_us: Int,
                     axes: Int) -> Bool [hw]
        tap_config(self, thresh_mg, dur_us, latent_us, window_us, axes)

    fn configure_activity(self, thresh_mg: Int, axes: Int) -> Bool [hw]
        activity_config(self, thresh_mg, axes)

    fn configure_inactivity(self, thresh_mg: Int, time_s: Int, axes: Int) -> Bool [hw]
        inactivity_config(self, thresh_mg, time_s, axes)

    fn configure_free_fall(self, thresh_mg: Int, time_ms: Int) -> Bool [hw]
        free_fall_config(self, thresh_mg, time_ms)

    // The interrupt pins (`int_config`), INT_SOURCE and ACT_TAP_STATUS.
    fn configure_interrupts(self, enable: Int, map: Int, active_low: Bool) -> Bool [hw]
        int_config(self, enable, map, active_low)

    fn interrupt_flags(self) -> Int [hw]
        int_source(self)

    fn tap_status(self) -> Int [hw]
        act_tap_status(self)

    // The self-test change in milli-g (`self_test_delta`).
    fn self_test(self) -> ?AccelMilliG [hw]
        self_test_delta(self)

impl Accelerometer[hw] for Adxl345Spi
    fn accel_read(self) -> ?AccelMilliG [hw]
        sample_read(self)

    fn accel_ready(self) -> Bool [hw]
        sample_ready(self)

    fn accel_range(self) -> AccelRange [hw]
        range_read(self)

    fn accel_set_range(self, r: AccelRange) -> Bool [hw]
        range_write(self, r)

    fn accel_rate_hz(self) -> Int [hw]
        rate_hz_read(self)

    fn accel_set_rate_hz(self, hz: Int) -> Int [hw]
        rate_hz_write(self, hz)

    fn accel_fifo_count(self) -> Int [hw]
        fifo_count(self)

    fn accel_fifo_read(self, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
        fifo_read(self, var dst)

impl Identifiable[hw] for Adxl345Spi
    // DEVID, 0xE5; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)
